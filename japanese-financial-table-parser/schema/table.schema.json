{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "page_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "filename",
        "sha256",
        "page_count"
      ],
      "additionalProperties": false
    },
    "extractor": {
      "type": "object",
      "properties": {
        "name": {
          "const": "pdfplumber"
        },
        "version": {
          "type": "string"
        },
        "method": {
          "const": "detected_cell_boundaries_and_label_indentation"
        }
      },
      "required": [
        "name",
        "version",
        "method"
      ],
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "source",
    "extractor",
    "pages"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baseline Japanese financial table extraction v1",
  "$defs": {
    "bbox": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "cell": {
      "type": "object",
      "properties": {
        "raw": {
          "type": "string"
        },
        "normalized": {
          "type": "string"
        },
        "value": {
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "enum": [
            "number",
            "dash",
            "blank"
          ]
        },
        "negative_zero": {
          "type": "boolean"
        },
        "source_bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/bbox"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "raw",
        "normalized",
        "value",
        "status",
        "negative_zero",
        "source_bbox"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer"
              },
              "raw": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              },
              "negative_zero": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "negative_zero": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "const": "number"
              },
              "value": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "blank"
              }
            }
          },
          "then": {
            "properties": {
              "normalized": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "dash"
              }
            }
          },
          "then": {
            "properties": {
              "normalized": {
                "enum": [
                  "-",
                  "−",
                  "―",
                  "—",
                  "–",
                  "ー"
                ]
              }
            }
          }
        }
      ]
    },
    "column": {
      "type": "object",
      "properties": {
        "id": {
          "enum": [
            "c1",
            "c2"
          ]
        },
        "label_raw": {
          "type": "string"
        },
        "date_raw": {
          "type": "string"
        },
        "period": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "source_bbox": {
          "$ref": "#/$defs/bbox"
        }
      },
      "required": [
        "id",
        "label_raw",
        "date_raw",
        "period",
        "source_bbox"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title_raw": {
          "type": "string"
        },
        "currency": {
          "const": "JPY"
        },
        "unit_raw": {
          "const": "千円"
        },
        "unit_multiplier": {
          "const": 1000
        },
        "correction_marker_raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "printed_page_number": {
          "type": [
            "integer",
            "null"
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/column"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "title_raw",
        "currency",
        "unit_raw",
        "unit_multiplier",
        "correction_marker_raw",
        "printed_page_number",
        "columns"
      ],
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^r\\d{3,}$"
        },
        "label_raw": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "kind": {
          "enum": [
            "section",
            "item",
            "subtotal",
            "net"
          ]
        },
        "label_x0": {
          "type": "number"
        },
        "source_bbox": {
          "$ref": "#/$defs/bbox"
        },
        "label_source_bbox": {
          "$ref": "#/$defs/bbox"
        },
        "cells": {
          "type": "object",
          "properties": {
            "c1": {
              "$ref": "#/$defs/cell"
            },
            "c2": {
              "$ref": "#/$defs/cell"
            }
          },
          "required": [
            "c1",
            "c2"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "label_raw",
        "label",
        "depth",
        "parent_id",
        "path",
        "kind",
        "label_x0",
        "source_bbox",
        "label_source_bbox",
        "cells"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "page_index": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "table_bbox": {
          "$ref": "#/$defs/bbox"
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          },
          "minItems": 1
        }
      },
      "required": [
        "page_index",
        "width",
        "height",
        "table_bbox",
        "metadata",
        "rows"
      ],
      "additionalProperties": false
    }
  }
}
